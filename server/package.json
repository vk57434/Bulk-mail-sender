{
  "name": "bulk-mail-backend",
  "version": "1.0.0",
  "description": "Bulk mail sender backend for authorized campaign management and email sending.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/email.worker.js",
    "queue:diagnostics": "node src/scripts/queue.diagnostics.js",
    "test": "node --check src/server.js && node --check src/workers/email.worker.js && node --check src/scripts/queue.diagnostics.js",
    "start:all": "concurrently --kill-others --names API,WORKER \"npm start\" \"npm run worker\""
  },
  "keywords": [
    "bulk-mail",
    "express",
    "mongodb",
    "redis",
    "bullmq",
    "nodemailer"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bullmq": "^6.3.10",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "googleapis": "^182.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.1",
    "pino": "^9.1.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "redis-server": "^1.2.2"
  }
}
