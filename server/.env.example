NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/bulk_mail

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

EMAIL_RATE_LIMIT_MS=10000

MAX_RECIPIENTS_PER_CAMPAIGN=10000
MAX_CSV_SIZE_MB=10

# CREDENTIAL_ENCRYPTION_KEY is REQUIRED for Gmail OAuth.
# Must be a 64-character hex string (32 bytes decoded) for AES-256-GCM.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/email-accounts/gmail/callback

FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5000
